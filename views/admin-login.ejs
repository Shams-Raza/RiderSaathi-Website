<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Portal — <%= settings.siteName %></title>
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .login-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      background: radial-gradient(circle at 50% 20%, rgba(29, 78, 216, 0.08) 0%, transparent 60%), var(--admin-bg);
    }
    .login-card {
      width: 100%;
      max-width: 420px;
      background: var(--admin-card);
      border: 1px solid var(--admin-border);
      border-radius: 20px;
      padding: 36px 32px;
      box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.08);
      position: relative;
      animation: loginFadeUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes loginFadeUp {
      from { opacity: 0; transform: translateY(12px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .login-card { animation: none; }
    }
    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    .brand-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, #1d4ed8, #2563eb);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 16px -4px rgba(29, 78, 216, 0.35);
    }
    .login-title {
      font-size: 22px;
      font-weight: 800;
      color: var(--admin-text);
      margin: 0 0 6px;
      letter-spacing: -0.02em;
    }
    .login-subtitle {
      font-size: 13.5px;
      color: var(--admin-muted);
      margin: 0 0 24px;
      line-height: 1.5;
    }
    .login-alert {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.25);
      color: #b91c1c;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13.5px;
      margin-bottom: 20px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .input-field-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .input-icon {
      position: absolute;
      left: 14px;
      color: var(--admin-muted);
      pointer-events: none;
      display: flex;
      align-items: center;
    }
    .login-card .form-group input {
      width: 100%;
      box-sizing: border-box;
      padding: 12px 14px 12px 42px;
      font-size: 14.5px;
      border-radius: 10px;
      border: 1px solid var(--admin-border);
      background: var(--admin-bg);
      color: var(--admin-text);
      transition: all 0.2s ease;
    }
    .login-card .form-group input:focus {
      outline: none;
      border-color: var(--admin-primary);
      box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.15);
      background: var(--admin-card);
    }
    .toggle-pwd-btn {
      position: absolute;
      right: 12px;
      background: transparent;
      border: 0;
      color: var(--admin-muted);
      cursor: pointer;
      padding: 6px;
      display: flex;
      align-items: center;
    }
    .toggle-pwd-btn:hover {
      color: var(--admin-text);
    }
    .login-btn {
      width: 100%;
      padding: 13px;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 700;
      background: var(--admin-primary);
      color: #ffffff;
      border: 0;
      cursor: pointer;
      margin-top: 10px;
      box-shadow: 0 8px 18px -4px rgba(29, 78, 216, 0.35);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .login-btn:hover {
      background: var(--admin-primary-hover);
      transform: translateY(-1px);
    }
    .login-btn:active {
      transform: translateY(1px);
    }
    .security-notice {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 22px;
      font-size: 12px;
      color: var(--admin-muted);
    }
  </style>
</head>
<body class="admin-body">
  <div class="login-wrapper">
    <div class="login-card">
      <div class="brand-badge">
        <div class="brand-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#fff"><path d="M14 2 5 13h6l-1 9 9-11h-6z"/></svg>
        </div>
        <div>
          <span style="font-size: 17px; font-weight: 800; color: var(--admin-text);"><%= settings.siteName %></span>
          <span style="display: block; font-size: 11px; font-weight: 700; color: var(--admin-primary); letter-spacing: 0.5px;">ADMINISTRATION</span>
        </div>
      </div>

      <h1 class="login-title">Admin Dashboard</h1>
      <p class="login-subtitle">Sign in to manage website content, drivers, pricing plans, and system settings.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0; margin-top:1px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="post" action="/admin/login" autocomplete="on">
        <div class="form-group" style="margin-bottom: 16px;">
          <label for="email" style="font-size: 13px; font-weight: 650; margin-bottom: 6px; display: block;">Admin Email or Username</label>
          <div class="input-field-wrap">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <input type="text" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" placeholder="admin@ridersaathi.in" required autofocus autocomplete="username">
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label for="password" style="font-size: 13px; font-weight: 650; margin-bottom: 6px; display: block;">Password</label>
          <div class="input-field-wrap">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <input type="password" id="password" name="password" placeholder="••••••••••••" required autocomplete="current-password">
            <button type="button" class="toggle-pwd-btn" id="togglePasswordBtn" aria-label="Toggle password visibility">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="login-btn">
          <span>Sign In to Dashboard</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      </form>

      <div class="security-notice">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>Protected by rate limiter &amp; HMAC 256 session token</span>
      </div>

      <div style="margin-top: 18px; text-align: center;">
        <a href="/" style="font-size: 13px; color: var(--admin-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 5px;">
          <span>&larr;</span> Back to website
        </a>
      </div>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const pwdInput = document.getElementById('password');
    if (toggleBtn && pwdInput) {
      toggleBtn.addEventListener('click', () => {
        const isPwd = pwdInput.type === 'password';
        pwdInput.type = isPwd ? 'text' : 'password';
      });
    }
  </script>
</body>
</html>
