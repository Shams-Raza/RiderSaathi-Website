<%- include('partials/header') %>

<div class="wrap">
  <div class="card" style="margin-top: 30px;">
    <h2>Contact us</h2>
    <p>Payment, refund, rules ya app problem — reach us here and we reply within 2 working days.</p>
    <ul>
      <li><strong>Founder:</strong> <%= settings.ownerName %></li>
      <li><strong>Email:</strong> <a href="mailto:<%= settings.contactEmail %>"><%= settings.contactEmail %></a></li>
      <li><strong>WhatsApp:</strong> <a href="https://wa.me/<%= settings.whatsappNumber %>" target="_blank" rel="noopener">+<%= settings.whatsappNumber %></a></li>
      <li><strong>Telegram:</strong> <a href="<%= settings.telegramUrl %>" target="_blank" rel="noopener"><%= settings.telegramHandle %></a></li>
      <li><strong>Address:</strong> <%= settings.officeAddress %></li>
      <li><strong>Support hours:</strong> <%= settings.supportHours %></li>
    </ul>
    
    <div class="notice" style="margin-top: 20px;">
      <p><strong>Stay safe:</strong> <%= settings.siteName %> will never ask for your OTP, UPI PIN, password or bank details, and never asks you to pay anyone over a call. Anyone who does is not us.<br>
      <%= settings.siteName %> kabhi aapka OTP, UPI PIN, password ya bank details nahi maangta. Koi maange to wo <%= settings.siteName %> nahi hai.</p>
    </div>
  </div>

  <div class="card">
    <h2>Send us a message</h2>
    <p>Aap apna sawal ya pareshani yahan likh kar bhej sakte hain. Hamari team turant revert karegi:</p>

    <div id="contactAlert" style="display:none;"></div>

    <form id="contactForm" class="delform">
      <label for="cName">Aapka Naam</label>
      <input type="text" id="cName" name="name" placeholder="Driver / Captain Name" required>

      <label for="cPhone">Mobile Number</label>
      <input type="tel" id="cPhone" name="phone" placeholder="10 digit mobile number" required pattern="[0-9]{10}">

      <label for="cSubject">Topic / Mudda</label>
      <select id="cSubject" name="subject" required>
        <option value="Payment & Plan Activation">Payment &amp; Plan Activation</option>
        <option value="App Installation & Permissions">App Installation &amp; Permissions</option>
        <option value="Rules & Booking Filtering">Rules &amp; Booking Filtering</option>
        <option value="Refund Request">Refund Request</option>
        <option value="Other">Other / General Question</option>
      </select>

      <label for="cMessage">Message / Dikkat</label>
      <textarea id="cMessage" name="message" rows="4" placeholder="Apni dikkat ya sawal yahan likhein..." required></textarea>

      <button type="submit">Send Message</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
