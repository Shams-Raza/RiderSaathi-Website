<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard &amp; CMS — <%= settings.siteName %></title>
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin.js" defer></script>
</head>
<body class="admin-body">
  <!-- Mobile Header Bar -->
  <div class="mobile-admin-bar">
    <div style="display:flex; align-items:center; gap:8px;">
      <div class="brand-icon-wrap" style="width:28px; height:28px;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="#fff"><path d="M14 2 5 13h6l-1 9 9-11h-6z"/></svg>
      </div>
      <strong style="font-size:15px;"><%= settings.siteName %> Admin</strong>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
      <button class="mobile-menu-btn" id="mobileMenuToggle" aria-label="Toggle navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="admin-layout">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar" id="adminSidebar">
      <a class="admin-brand" href="/admin">
        <div class="brand-icon-wrap">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="#fff"><path d="M14 2 5 13h6l-1 9 9-11h-6z"/></svg>
        </div>
        <span><%= settings.siteName %></span>
        <span class="badge">CMS</span>
      </a>

      <div class="admin-nav-section-title">Main Dashboard</div>
      <nav class="admin-nav">
        <button class="admin-nav-item active" data-tab="tabOverview">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Overview
        </button>
        <button class="admin-nav-item" data-tab="tabDrivers">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          Drivers (<%= drivers.length %>)
          <span class="nav-counter"><%= drivers.length %></span>
        </button>
        <button class="admin-nav-item" data-tab="tabOrders">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          Orders (<%= orders.length %>)
          <span class="nav-counter"><%= orders.length %></span>
        </button>
      </nav>

      <div class="admin-nav-section-title">Content Management (CMS)</div>
      <nav class="admin-nav">
        <button class="admin-nav-item" data-tab="tabHomeCms">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          Home Page CMS
        </button>
        <button class="admin-nav-item" data-tab="tabPlans">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          Pricing Plans (<%= plans.length %>)
        </button>
        <button class="admin-nav-item" data-tab="tabApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
          APK &amp; Version
        </button>
        <button class="admin-nav-item" data-tab="tabGuides">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          Guides &amp; Tutorials (<%= guides.length %>)
        </button>
        <button class="admin-nav-item" data-tab="tabFaq">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          FAQs (<%= faqs.length %>)
        </button>
        <button class="admin-nav-item" data-tab="tabInquiries">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          Messages (<%= inquiries.length %>)
        </button>
      </nav>

      <div class="admin-nav-section-title">Site Settings &amp; SEO</div>
      <nav class="admin-nav">
        <button class="admin-nav-item" data-tab="tabContact">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Contact &amp; Support
        </button>
        <button class="admin-nav-item" data-tab="tabFooter">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Footer &amp; Legal
        </button>
        <button class="admin-nav-item" data-tab="tabSeo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          SEO &amp; Meta Tags
        </button>
        <button class="admin-nav-item" data-tab="tabPayment">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          UPI &amp; Payments
        </button>
        <button class="admin-nav-item" data-tab="tabSecurity">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Security &amp; Backup
        </button>
      </nav>

      <div class="admin-sidebar-footer">
        <a href="/api/docs" target="_blank" class="btn-outline" style="text-decoration:none; font-size:12.5px;">
          ⚡ REST API Docs
        </a>
        <a href="/" target="_blank" class="btn-outline" style="text-decoration:none; font-size:12.5px;">
          🌐 View Live Site
        </a>
        <a href="/admin/logout" class="btn-outline" style="text-decoration:none; color:var(--admin-danger); font-size:12.5px;">
          🚪 Log Out
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main">
      <!-- Top Navbar Header -->
      <div class="admin-header">
        <div>
          <h1>Dashboard &amp; Content Management</h1>
          <div style="font-size: 13.5px; color: var(--admin-muted); margin-top: 3px;">
            Full administrative control for <%= settings.siteName %> website, driver app, pricing &amp; APIs.
          </div>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
          <div class="admin-user-pill" title="Active Admin Session">
            <span class="status-dot"></span>
            <span><%= typeof adminEmail !== 'undefined' ? adminEmail : 'admin@ridersaathi.in' %></span>
          </div>
          <button id="themeToggleBtn" class="btn-outline" title="Toggle Light/Dark Theme">
            🌓 Theme
          </button>
          <a href="/api/admin/backup/export" class="btn-outline" style="text-decoration:none;">
            📥 Backup JSON
          </a>
        </div>
      </div>

      <!-- Toast Notification Message -->
      <div id="adminToast" class="toast-msg"></div>

      <!-- ================= 1. TAB: OVERVIEW ================= -->
      <div class="tab-pane active" id="tabOverview">
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-title">Registered Drivers</span>
            <span class="stat-value"><%= drivers.length %></span>
            <span class="stat-help">App installs &amp; phone accounts</span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Rides Filtered</span>
            <span class="stat-value"><%= stats.totalRidesFiltered || 0 %></span>
            <span class="stat-help">Total rides accepted via app</span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Website Visitors</span>
            <span class="stat-value"><%= stats.visitors || 0 %></span>
            <span class="stat-help">Total page impressions</span>
          </div>
          <div class="stat-card">
            <span class="stat-title">APK Downloads</span>
            <span class="stat-value"><%= stats.downloads || 0 %></span>
            <span class="stat-help">Driver app downloads</span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Plan Orders</span>
            <span class="stat-value"><%= orders.length %></span>
            <span class="stat-help">Subscription requests</span>
          </div>
          <div class="stat-card">
            <span class="stat-title">Inquiries</span>
            <span class="stat-value"><%= inquiries.length %></span>
            <span class="stat-help">Contact form messages</span>
          </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="admin-card">
          <h2>⚡ Quick CMS Actions</h2>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px;">
            <button class="btn-primary" onclick="switchTab('tabHomeCms')">📝 Edit Home Page Text</button>
            <button class="btn-outline" onclick="openPlanModal()">➕ Add Pricing Plan</button>
            <button class="btn-outline" onclick="openGuideModal()">📚 Add Driver Guide</button>
            <button class="btn-outline" onclick="openFaqModal()">❓ Add FAQ</button>
            <button class="btn-outline" onclick="switchTab('tabApp')">📲 Update APK Version</button>
            <button class="btn-outline" onclick="switchTab('tabSecurity')">🔒 Change Password</button>
          </div>
        </div>

        <!-- Recent Orders -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h2>Recent Orders (<%= orders.slice(0, 5).length %> of <%= orders.length %>)</h2>
            <button class="btn-outline btn-sm" onclick="switchTab('tabOrders')">View All Orders &rarr;</button>
          </div>
          <% if (orders.length === 0) { %>
            <p style="color: var(--admin-muted);">No subscription orders placed yet.</p>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Driver Phone</th>
                    <th>Plan</th>
                    <th>Amount</th>
                    <th>UTR / Ref</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.slice(0, 5).forEach(ord => { %>
                  <tr>
                    <td><%= new Date(ord.createdAt).toLocaleDateString() %></td>
                    <td><strong><%= ord.phone %></strong></td>
                    <td><%= ord.planName %></td>
                    <td>₹<%= ord.amount || ord.price %></td>
                    <td><code><%= ord.utr || ord.upiRef || 'Waiting' %></code></td>
                    <td>
                      <span class="badge-tag <%= ord.status === 'Activated' ? 'badge-success' : 'badge-warning' %>">
                        <%= ord.status %>
                      </span>
                    </td>
                    <td>
                      <% if (ord.status !== 'Activated') { %>
                        <button class="btn-primary btn-sm" onclick="approveAndActivateOrder('<%= ord.id %>')">
                          ⚡ Activate Driver
                        </button>
                      <% } else { %>
                        <span style="color:var(--admin-success); font-weight:600; font-size:12px;">Active</span>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

        <!-- Recent Registered Drivers -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h2>Recent App Drivers (<%= drivers.slice(0, 5).length %> of <%= drivers.length %>)</h2>
            <button class="btn-outline btn-sm" onclick="switchTab('tabDrivers')">View All Drivers &rarr;</button>
          </div>
          <% if (drivers.length === 0) { %>
            <p style="color: var(--admin-muted);">No drivers have launched the app yet.</p>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Driver</th>
                    <th>Phone</th>
                    <th>Version</th>
                    <th>Trial Left</th>
                    <th>Status</th>
                    <th>Quick Pass</th>
                  </tr>
                </thead>
                <tbody>
                  <% drivers.slice(0, 5).forEach(drv => { 
                    const trialLeft = Math.max(0, (drv.trialRidesTotal || 10) - (drv.trialRidesUsed || 0));
                  %>
                  <tr>
                    <td><strong><%= drv.name || 'Captain' %></strong></td>
                    <td><code><%= drv.phone %></code></td>
                    <td>v<%= drv.appVersion || '5.28.1' %></td>
                    <td><span style="font-weight:700; color:<%= trialLeft > 0 ? '#10b981' : '#ef4444' %>"><%= trialLeft %> rides</span></td>
                    <td>
                      <span class="badge-tag <%= drv.status === 'banned' ? 'badge-danger' : 'badge-success' %>">
                        <%= drv.status || 'active' %>
                      </span>
                    </td>
                    <td>
                      <button class="btn-primary btn-sm" onclick="grantSubscription('<%= drv.id %>', 7, '7 Days Pass')">+7 Days</button>
                      <button class="btn-outline btn-sm" onclick="grantTrialRides('<%= drv.id %>', 10)">+10 Free</button>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ================= 2. TAB: HOME PAGE CMS ================= -->
      <div class="tab-pane" id="tabHomeCms">
        <div class="admin-card">
          <h2>Hero Section &amp; Headings</h2>
          <div class="admin-card-desc">Bina kisi code badlaav ke Home page ke headings, text aur badges yahan se edit karein:</div>

          <form id="homeCmsForm">
            <div class="form-grid">
              <div class="form-group full-width">
                <label>Hero Free Trial Badge</label>
                <input type="text" name="heroBadge" value="<%= settings.heroBadge || '' %>" placeholder="e.g. ⚡ Pehle 10 rides bilkul free — bina kisi payment ke test karo!">
                <div class="field-hint">Dikhne wala green pill-badge hero heading ke upar.</div>
              </div>

              <div class="form-group full-width">
                <label>Hero Main Title (HTML supported: &lt;br&gt;, &lt;span class="highlight"&gt;...&lt;/span&gt;)</label>
                <input type="text" name="heroTitle" value="<%= settings.heroTitle || '' %>" placeholder="Ghaate wali rides chhodo,<br><span class='highlight'>Kamai wali rides uthao!</span>" required>
              </div>

              <div class="form-group full-width">
                <label>Hero Subtitle (Hindi)</label>
                <textarea name="heroSubtitle" rows="3" required><%= settings.heroSubtitle || '' %></textarea>
              </div>

              <div class="form-group full-width">
                <label>Hero English Secondary Text</label>
                <textarea name="heroEnText" rows="3"><%= settings.heroEnText || '' %></textarea>
              </div>

              <div class="form-group">
                <label>Free Trial Text Tag</label>
                <input type="text" name="freeRidesTrial" value="<%= settings.freeRidesTrial || 'Pehle 10 rides bilkul free' %>">
              </div>

              <div class="form-group">
                <label>Top Announcement Bar Message</label>
                <input type="text" name="bannerAlert" value="<%= settings.bannerAlert || '' %>">
              </div>

              <div class="form-group full-width">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                  <input type="checkbox" name="showBanner" <%= settings.showBanner ? 'checked' : '' %> style="width: auto;">
                  Top Announcement Bar ko website par dikhayein (Show Top Banner)
                </label>
              </div>
            </div>

            <div style="margin-top: 30px;">
              <h3 style="font-size: 16px; font-weight: 750; margin-bottom: 12px;">Home Page Section Toggles (Show / Hide)</h3>
              <p class="admin-card-desc">Jin sections ko aap abhi live website par hide ya show karna chahein unhe toggle karein:</p>

              <% 
                const hs = settings.homeSections || {};
              %>
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
                <div class="toggle-switch-card">
                  <div class="toggle-info">
                    <span class="toggle-title">Interactive Phone Simulator</span>
                    <span class="toggle-desc">Hero right side animated phone mockup</span>
                  </div>
                  <label class="switch">
                    <input type="checkbox" name="homeSections_heroSimulator" <%= hs.heroSimulator !== false ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </div>

                <div class="toggle-switch-card">
                  <div class="toggle-info">
                    <span class="toggle-title">Supported Apps Bar</span>
                    <span class="toggle-desc">Rapido, Uber, Porter, Shadowfax chips</span>
                  </div>
                  <label class="switch">
                    <input type="checkbox" name="homeSections_supportedApps" <%= hs.supportedApps !== false ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </div>

                <div class="toggle-switch-card">
                  <div class="toggle-info">
                    <span class="toggle-title">3 Big Driver Problems</span>
                    <span class="toggle-desc">Problem &amp; solution cards</span>
                  </div>
                  <label class="switch">
                    <input type="checkbox" name="homeSections_driverProblems" <%= hs.driverProblems !== false ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </div>

                <div class="toggle-switch-card">
                  <div class="toggle-info">
                    <span class="toggle-title">What Rules You Control</span>
                    <span class="toggle-desc">Pickup, Fare, Route rules grid</span>
                  </div>
                  <label class="switch">
                    <input type="checkbox" name="homeSections_ruleFeatures" <%= hs.ruleFeatures !== false ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </div>

                <div class="toggle-switch-card">
                  <div class="toggle-info">
                    <span class="toggle-title">Pricing Plans Preview</span>
                    <span class="toggle-desc">Show plans grid on homepage</span>
                  </div>
                  <label class="switch">
                    <input type="checkbox" name="homeSections_pricingPreview" <%= hs.pricingPreview !== false ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </div>

                <div class="toggle-switch-card">
                  <div class="toggle-info">
                    <span class="toggle-title">Driver Reviews / Testimonials</span>
                    <span class="toggle-desc">Real captain feedback cards</span>
                  </div>
                  <label class="switch">
                    <input type="checkbox" name="homeSections_driverReviews" <%= hs.driverReviews !== false ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </div>

                <div class="toggle-switch-card">
                  <div class="toggle-info">
                    <span class="toggle-title">WhatsApp Community CTA Card</span>
                    <span class="toggle-desc">Bottom direct contact banner</span>
                  </div>
                  <label class="switch">
                    <input type="checkbox" name="homeSections_communityCard" <%= hs.communityCard !== false ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </div>
              </div>
            </div>

            <div class="form-actions" style="margin-top: 24px;">
              <button type="submit" class="btn-primary">💾 Save Home Page Changes</button>
              <a href="/" target="_blank" class="btn-outline" style="text-decoration:none;">Preview Live Home Page &rarr;</a>
            </div>
          </form>
        </div>
      </div>

      <!-- ================= 3. TAB: PRICING PLANS CRUD ================= -->
      <div class="tab-pane" id="tabPlans">
        <div class="admin-card">
          <div class="admin-card-header">
            <div>
              <h2>Pricing Plans Management (<%= plans.length %>)</h2>
              <div class="admin-card-desc">Plans add, edit aur delete karein. Ye changes website ke Pricing section aur Mobile App me turant update honge.</div>
            </div>
            <button class="btn-primary" onclick="openPlanModal()">➕ Add New Plan</button>
          </div>

          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Plan ID</th>
                  <th>Name</th>
                  <th>Offer Price</th>
                  <th>Cut-off Price</th>
                  <th>Duration</th>
                  <th>Badge</th>
                  <th>Status</th>
                  <th>Description</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% plans.forEach(p => { %>
                <tr>
                  <td><code><%= p.id %></code></td>
                  <td><strong><%= p.name %></strong></td>
                  <td><span style="font-weight:750; color:var(--admin-primary);">₹<%= p.price %></span></td>
                  <td><%= p.wasPrice ? '₹' + p.wasPrice : '-' %></td>
                  <td><%= p.durationDays %> days (<%= p.durationText %>)</td>
                  <td>
                    <% if (p.badge) { %>
                      <span class="badge-tag badge-warning"><%= p.badge %></span>
                    <% } else { %>
                      <span style="color:var(--admin-subtle);">-</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge-tag <%= p.active !== false ? 'badge-success' : 'badge-danger' %>">
                      <%= p.active !== false ? 'Active' : 'Hidden' %>
                    </span>
                  </td>
                  <td style="max-width: 220px; font-size: 12.5px; color: var(--admin-muted);"><%= p.description || '-' %></td>
                  <td>
                    <div style="display: flex; gap: 6px;">
                      <button class="btn-outline btn-sm" onclick='editPlan(<%- JSON.stringify(p) %>)'>Edit</button>
                      <button class="btn-outline btn-sm" style="color:var(--admin-danger);" onclick="deletePlan('<%= p.id %>')">Delete</button>
                    </div>
                  </td>
                </tr>
