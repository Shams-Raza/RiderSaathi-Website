                </label>
              </div>

              <!-- YouTube -->
              <div class="form-group">
                <label>YouTube Channel URL</label>
                <input type="url" name="socialLinks[youtube][url]" value="<%= (soc.youtube && soc.youtube.url) || 'https://youtube.com/@ridersaathi' %>">
              </div>
              <div class="form-group" style="display:flex; align-items:flex-end;">
                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                  <input type="checkbox" name="socialLinks[youtube][enabled]" <%= (!soc.youtube || soc.youtube.enabled !== false) ? 'checked' : '' %> style="width:auto;">
