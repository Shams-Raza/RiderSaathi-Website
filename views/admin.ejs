      <!-- ================= 4. TAB: PRICING PLANS CRUD (Requirement 5) ================= -->
      <div class="tab-pane" id="tabPlans">
        <div class="admin-card">
          <div class="admin-card-header">
            <div>
              <h2>Pricing Plans Management (<%= plans.length %>)</h2>
              <div class="admin-card-desc">Plans add, edit aur delete karein. Har plan ke features, benefits aur Hindi/English details yahan se manage karein:</div>
            </div>
            <button class="btn-primary" onclick="openPlanModal()">➕ Add New Plan</button>
          </div>

          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Plan ID</th>
                  <th>Name (EN / HI)</th>
                  <th>Offer Price</th>
                  <th>Original</th>
                  <th>Duration</th>
                  <th>Badge</th>
                  <th>Features Count</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% plans.forEach(p => { %>
                <tr>
                  <td><code><%= p.id %></code></td>
                  <td>
                    <strong><%= p.name %></strong><br>
                    <span style="font-size:12px; color:var(--admin-muted);"><%= p.name_hi || p.name %></span>
                  </td>
                  <td><span style="font-weight:750; color:var(--admin-primary);">₹<%= p.price %></span></td>
                  <td><%= p.wasPrice ? '₹' + p.wasPrice : '-' %></td>
                  <td><%= p.durationDays %>d (<%= p.durationText %>)</td>
                  <td>
                    <% if (p.badge) { %>
                      <span class="badge-tag badge-warning"><%= p.badge %></span>
                    <% } else { %>
                      <span style="color:var(--admin-subtle);">-</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge-tag badge-info"><%= (p.features && p.features.length) || 0 %> features</span>
                  </td>
                  <td>
                    <span class="badge-tag <%= p.active !== false ? 'badge-success' : 'badge-danger' %>">
                      <%= p.active !== false ? 'Active' : 'Hidden' %>
                    </span>
                  </td>
                  <td>
                    <div style="display: flex; gap: 6px;">
                      <button class="btn-outline btn-sm" onclick='editPlan(<%- JSON.stringify(p) %>)'>Edit</button>
                      <button class="btn-outline btn-sm" style="color:var(--admin-danger);" onclick="deletePlan('<%= p.id %>')">Delete</button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

