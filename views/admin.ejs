          </div>
          <div class="form-actions">
            <a href="/api/admin/backup/export" class="btn-primary" style="text-decoration:none;">
              📥 Download Full JSON Backup
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>

  <!-- ================= MODALS ================= -->

  <!-- 1. Plan Add / Edit Modal (with Feature List Builder & Bilingual Details) -->
  <div class="modal-overlay" id="planModal">
    <div class="modal-dialog" style="max-width: 680px;">
      <div class="modal-header">
        <h3 class="modal-title" id="planModalTitle">Add Pricing Plan</h3>
        <button type="button" class="modal-close-btn" onclick="closeModal('planModal')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body">
        <form id="planForm">
          <input type="hidden" id="planId" name="id">
          <div class="form-grid">
            <div class="form-group">
              <label>Plan Name (English)</label>
              <input type="text" id="planName" name="name" placeholder="e.g. 1 Week Pass" required>
            </div>
            <div class="form-group">
              <label>Plan Name (Hindi)</label>
              <input type="text" id="planNameHi" name="name_hi" placeholder="e.g. 1 हफ्ते का पास">
            </div>
            <div class="form-group">
              <label>Offer Price (₹)</label>
              <input type="number" id="planPrice" name="price" placeholder="e.g. 68" required>
            </div>
            <div class="form-group">
              <label>Original Price (₹ cut-off)</label>
              <input type="number" id="planWasPrice" name="wasPrice" placeholder="e.g. 84">
            </div>
            <div class="form-group">
              <label>Duration in Days</label>
              <input type="number" id="planDurationDays" name="durationDays" placeholder="e.g. 7" required>
            </div>
            <div class="form-group">
              <label>Duration Text (English)</label>
              <input type="text" id="planDurationText" name="durationText" placeholder="e.g. 7 days" required>
            </div>
            <div class="form-group">
              <label>Duration Text (Hindi)</label>
              <input type="text" id="planDurationTextHi" name="durationText_hi" placeholder="e.g. 7 दिन">
            </div>
            <div class="form-group">
              <label>Ribbon Badge (English)</label>
              <input type="text" id="planBadge" name="badge" placeholder="e.g. Popular">
            </div>
            <div class="form-group">
              <label>Ribbon Badge (Hindi)</label>
              <input type="text" id="planBadgeHi" name="badge_hi" placeholder="e.g. लोकप्रिय">
            </div>
            <div class="form-group full-width">
              <label>Description (English)</label>
              <input type="text" id="planDescription" name="description" placeholder="e.g. Best for full weekly shifts & high savings">
            </div>
            <div class="form-group full-width">
              <label>Description (Hindi)</label>
              <input type="text" id="planDescriptionHi" name="description_hi" placeholder="e.g. पूरी हफ़्ते की शिफ्ट और अधिक बचत के लिए बेस्ट">
            </div>
            
            <!-- Features List (One feature per line) -->
            <div class="form-group full-width">
              <label>Plan Features (English - One item per line)</label>
              <textarea id="planFeatures" name="features" rows="4" placeholder="Rapido, Uber & Porter Support&#10;Go-To (Towards Home) Route Filter&#10;Pickup & Fare Rules&#10;Voice & Sound Alerts"></textarea>
            </div>
            <div class="form-group full-width">
              <label>Plan Features (Hindi - One item per line)</label>
              <textarea id="planFeaturesHi" name="features_hi" rows="4" placeholder="Rapido, Uber और Porter सपोर्ट&#10;घर की तरफ (Go-To) रूट फ़िल्टर&#10;पिकअप और किराया रूल्स&#10;आवाज और साउंड अलर्ट्स"></textarea>
            </div>

            <div class="form-group full-width">
              <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                <input type="checkbox" id="planActive" name="active" checked style="width:auto;">
                Plan Active &amp; Visible on Website
              </label>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">Save Plan</button>
            <button type="button" class="btn-outline" onclick="closeModal('planModal')">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 2. Guide Add / Edit Modal -->
  <div class="modal-overlay" id="guideModal">
    <div class="modal-dialog" style="max-width: 680px;">
      <div class="modal-header">
        <h3 class="modal-title" id="guideModalTitle">Add Driver Guide</h3>
        <button type="button" class="modal-close-btn" onclick="closeModal('guideModal')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body">
        <form id="guideForm">
          <input type="hidden" id="guideOriginalSlug" name="originalSlug">
          <div class="form-grid">
            <div class="form-group full-width">
              <label>Guide Title</label>
              <input type="text" id="guideTitle" name="title" placeholder="e.g. Trip distance aur pickup distance rules" required>
            </div>
            <div class="form-group">
              <label>Category</label>
              <input type="text" id="guideCategory" name="category" placeholder="e.g. Rules — ek-ek karke">
            </div>
            <div class="form-group">
              <label>URL Slug (Optional, auto-generated from title)</label>
              <input type="text" id="guideSlug" name="slug" placeholder="e.g. trip-aur-pickup-distance">
            </div>
            <div class="form-group full-width">
              <label>Short Summary</label>
              <textarea id="guideSummary" name="summary" rows="2" placeholder="Brief summary of what this guide teaches..."></textarea>
            </div>
            <div class="form-group full-width">
              <label>Content (HTML tags allowed: &lt;h3&gt;, &lt;p&gt;, &lt;ul&gt;, &lt;li&gt;, &lt;strong&gt;)</label>
              <textarea id="guideContent" name="content" rows="8" placeholder="Guide tutorial content..." required></textarea>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">Save Guide</button>
            <button type="button" class="btn-outline" onclick="closeModal('guideModal')">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 3. FAQ Add / Edit Modal -->
  <div class="modal-overlay" id="faqModal">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title" id="faqModalTitle">Add FAQ</h3>
        <button type="button" class="modal-close-btn" onclick="closeModal('faqModal')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body">
        <form id="faqForm">
          <input type="hidden" id="faqId" name="id">
          <div class="form-group" style="margin-bottom: 14px;">
            <label>Question (Sawal)</label>
            <input type="text" id="faqQ" name="q" placeholder="e.g. Play Protect warning aaye to kya karein?" required>
          </div>
          <div class="form-group" style="margin-bottom: 14px;">
            <label>Answer (Jawab)</label>
            <textarea id="faqA" name="a" rows="4" placeholder="Jawab likhein..." required></textarea>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">Save FAQ</button>
            <button type="button" class="btn-outline" onclick="closeModal('faqModal')">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
