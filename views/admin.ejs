                          <button class="btn-primary btn-sm" onclick="updateInquiryStatus('<%= inq.id %>', 'Resolved')">Mark Resolved</button>
                        <% } %>
                        <a href="https://wa.me/91<%= inq.phone %>" target="_blank" class="btn-outline btn-sm" style="text-decoration:none;">Reply</a>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

