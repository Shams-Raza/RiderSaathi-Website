              </div>
              <div class="form-group" style="display:flex; align-items:flex-end;">
                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                  <input type="checkbox" name="socialLinks[whatsapp][enabled]" <%= (!soc.whatsapp || soc.whatsapp.enabled !== false) ? 'checked' : '' %> style="width:auto;">
                  WhatsApp Icon Visible on Website
                </label>
              </div>

              <!-- Instagram -->
              <div class="form-group">
                <label>Instagram Profile URL</label>
                <input type="url" name="socialLinks[instagram][url]" value="<%= (soc.instagram && soc.instagram.url) || 'https://instagram.com/ridersaathi' %>">
              </div>
              <div class="form-group" style="display:flex; align-items:flex-end;">
                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                  <input type="checkbox" name="socialLinks[instagram][enabled]" <%= (!soc.instagram || soc.instagram.enabled !== false) ? 'checked' : '' %> style="width:auto;">
