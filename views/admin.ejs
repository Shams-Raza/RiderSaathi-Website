              <div class="form-group">
                <label>Current App Version</label>
                <input type="text" name="appVersion" value="<%= settings.appVersion %>" placeholder="e.g. 5.28.1" required>
              </div>

              <div class="form-group">
                <label>APK File Size</label>
                <input type="text" name="apkFileSize" value="<%= settings.apkFileSize %>" placeholder="e.g. 11.1 MB" required>
              </div>

              <div class="form-group">
                <label>Release Date</label>
                <input type="date" name="releaseDate" value="<%= settings.releaseDate || '' %>">
              </div>

              <div class="form-group">
                <label>Free Trial Rides on Install</label>
                <input type="text" name="freeRidesTrial" value="<%= settings.freeRidesTrial %>">
              </div>

              <div class="form-group full-width">
                <label>APK Download URL</label>
                <input type="text" name="apkDownloadUrl" value="<%= settings.apkDownloadUrl %>" placeholder="e.g. /downloads/RiderSaathi-v5.28.1.apk" required>
              </div>

              <div class="form-group full-width">
                <label>SHA-256 APK File Fingerprint</label>
                <input type="text" name="sha256File" value="<%= settings.sha256File %>" placeholder="64-character SHA-256 hash">
              </div>

              <div class="form-group full-width">
                <label>SHA-256 Signing Certificate Hash</label>
                <input type="text" name="sha256Cert" value="<%= settings.sha256Cert %>" placeholder="64-character Certificate hash">
              </div>

              <div class="form-group full-width">
                <label>Release Notes / What's New</label>
                <textarea name="releaseNotes" rows="3" placeholder="Describe improvements in this version..."><%= settings.releaseNotes || '' %></textarea>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-primary">💾 Save APK Settings</button>
              <a href="<%= settings.apkDownloadUrl %>" target="_blank" class="btn-outline" style="text-decoration:none;">Direct Download Test &rarr;</a>
            </div>
          </form>
        </div>
      </div>

      <!-- ================= 5. TAB: GUIDES & TUTORIALS CRUD ================= -->
      <div class="tab-pane" id="tabGuides">
        <div class="admin-card">
          <div class="admin-card-header">
            <div>
              <h2>Driver Guides &amp; Tutorials (<%= guides.length %>)</h2>
              <div class="admin-card-desc">Installation guide, rules tutorial aur permissions ki jaankari yahan se add, edit ya delete karein.</div>
            </div>
            <button class="btn-primary" onclick="openGuideModal()">➕ Add New Guide</button>
          </div>

          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Slug</th>
                  <th>Category</th>
                  <th>Summary</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% guides.forEach(g => { %>
                <tr>
                  <td><strong><%= g.title %></strong></td>
                  <td><code><%= g.slug %></code></td>
                  <td><span class="badge-tag badge-info"><%= g.category || 'General' %></span></td>
                  <td style="max-width: 280px; font-size: 12.5px; color: var(--admin-muted);"><%= g.summary %></td>
                  <td>
                    <div style="display: flex; gap: 6px;">
                      <button class="btn-outline btn-sm" onclick='editGuide(<%- JSON.stringify(g) %>)'>Edit</button>
                      <a href="/guides/<%= g.slug %>" target="_blank" class="btn-outline btn-sm" style="text-decoration:none;">View</a>
                      <button class="btn-outline btn-sm" style="color:var(--admin-danger);" onclick="deleteGuide('<%= g.slug %>')">Delete</button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= 6. TAB: FAQS CRUD ================= -->
      <div class="tab-pane" id="tabFaq">
