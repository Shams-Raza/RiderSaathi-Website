                </label>
              </div>

              <!-- Facebook -->
              <div class="form-group">
                <label>Facebook Page URL</label>
                <input type="url" name="socialLinks[facebook][url]" value="<%= (soc.facebook && soc.facebook.url) || 'https://facebook.com/ridersaathi' %>">
              </div>
              <div class="form-group" style="display:flex; align-items:flex-end;">
                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                  <input type="checkbox" name="socialLinks[facebook][enabled]" <%= (!soc.facebook || soc.facebook.enabled !== false) ? 'checked' : '' %> style="width:auto;">
