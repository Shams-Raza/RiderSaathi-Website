          <div class="admin-card-header">
            <div>
              <h2>Frequently Asked Questions (<%= faqs.length %>)</h2>
              <div class="admin-card-desc">Sawal aur Jawab manage karein jo drivers website ke FAQ section me dekhte hain:</div>
            </div>
