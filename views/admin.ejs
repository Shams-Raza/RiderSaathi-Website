                  <th>Answer (Jawab)</th>
                  <th style="width: 120px;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% faqs.forEach(f => { %>
                <tr>
                  <td style="font-weight: 650;"><%= f.q %></td>
                  <td style="color: var(--admin-muted); font-size: 13px;"><%= f.a %></td>
                  <td>
                    <div style="display: flex; gap: 6px;">
                      <button class="btn-outline btn-sm" onclick='editFaq(<%- JSON.stringify(f) %>)'>Edit</button>
                      <button class="btn-outline btn-sm" style="color:var(--admin-danger);" onclick="deleteFaq('<%= f.id %>')">Delete</button>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= 7. TAB: DRIVERS MANAGEMENT ================= -->
      <div class="tab-pane" id="tabDrivers">
        <div class="admin-card">
          <div class="admin-card-header">
            <div>
              <h2>All Registered Drivers (<%= drivers.length %>)</h2>
              <div class="admin-card-desc">Mobile app users ka live access, subscription status, trial balance aur ban switch control karein:</div>
            </div>
            <div class="filter-search-bar" style="margin-bottom: 0;">
              <input type="text" id="driverSearchInput" class="search-box-input" placeholder="Search by phone, name or model...">
            </div>
          </div>

          <% if (drivers.length === 0) { %>
            <p style="color: var(--admin-muted);">No drivers registered yet. Jaise hi koi driver app kholega, uska account yahan aa jayega.</p>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table" id="driversTable">
                <thead>
                  <tr>
                    <th>Driver / Phone</th>
                    <th>Device &amp; App</th>
                    <th>Trial Left</th>
                    <th>Subscription</th>
                    <th>Total Rides</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% drivers.forEach(drv => { 
                    const trialUsed = drv.trialRidesUsed || 0;
                    const trialTotal = drv.trialRidesTotal || 10;
                    const trialLeft = Math.max(0, trialTotal - trialUsed);
                    
                    let subText = 'None / Trial';
                    let subBadge = 'badge-warning';
                    if (drv.subscription && drv.subscription.expiresAt) {
                      const exp = new Date(drv.subscription.expiresAt);
                      if (exp > new Date()) {
                        const daysLeft = Math.ceil((exp - new Date()) / (1000 * 60 * 60 * 24));
                        subText = `${drv.subscription.planName || 'Active'} (${daysLeft}d left)`;
                        subBadge = 'badge-success';
                      } else {
                        subText = 'Expired';
                        subBadge = 'badge-danger';
                      }
                    }
                  %>
                  <tr class="driver-row" data-search="<%= (drv.name || '') + ' ' + drv.phone + ' ' + (drv.deviceModel || '') %>">
                    <td>
                      <strong><%= drv.name || 'Captain' %></strong><br>
                      <a href="https://wa.me/91<%= drv.phone %>" target="_blank" style="color:var(--admin-primary); text-decoration:none; font-size:12.5px;">
                        📱 +91 <%= drv.phone %>
                      </a>
                    </td>
                    <td>
                      <span style="font-weight:600;"><%= drv.deviceModel || 'Android' %></span><br>
                      <span style="font-size:11.5px; color:var(--admin-muted);">v<%= drv.appVersion || '5.28.1' %></span>
                    </td>
                    <td>
                      <span style="font-weight:750; color:<%= trialLeft > 0 ? '#10b981' : '#ef4444' %>">
                        <%= trialLeft %> / <%= trialTotal %>
                      </span>
                      <div style="font-size:11px; color:var(--admin-muted);">free rides</div>
                    </td>
                    <td>
                      <span class="badge-tag <%= subBadge %>">
                        <%= subText %>
                      </span>
                    </td>
                    <td>
                      <strong><%= drv.totalRidesAccepted || 0 %></strong>
                    </td>
                    <td>
                      <span class="badge-tag <%= drv.status === 'banned' ? 'badge-danger' : 'badge-success' %>">
                        <%= drv.status || 'active' %>
                      </span>
                    </td>
                    <td>
                      <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                        <button class="btn-primary btn-sm" onclick="grantSubscription('<%= drv.id %>', 1, '1 Day Pass')" title="Grant 1 Day">+1D</button>
                        <button class="btn-primary btn-sm" onclick="grantSubscription('<%= drv.id %>', 7, '7 Days Pass')" title="Grant 7 Days">+7D</button>
                        <button class="btn-primary btn-sm" onclick="grantSubscription('<%= drv.id %>', 30, '30 Days Pass')" title="Grant 30 Days">+30D</button>
                        <button class="btn-outline btn-sm" onclick="grantTrialRides('<%= drv.id %>', 10)" title="Add 10 Free Rides">+10 Free</button>
                        <button class="btn-outline btn-sm" style="color: <%= drv.status === 'banned' ? 'green' : 'red' %>;" onclick="toggleDriverStatus('<%= drv.id %>')">
                          <%= drv.status === 'banned' ? 'Unban' : 'Ban' %>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ================= 8. TAB: ORDERS & SUBSCRIPTIONS ================= -->
      <div class="tab-pane" id="tabOrders">
        <div class="admin-card">
          <div class="admin-card-header">
            <div>
              <h2>All Subscription Orders &amp; UPI Leads (<%= orders.length %>)</h2>
              <div class="admin-card-desc">Jab koi driver Buy form bharta hai aur UPI se pay karta hai, wo yahan show hota hai. 1-click me verify aur activate karein:</div>
            </div>
            <div class="filter-search-bar" style="margin-bottom: 0;">
              <input type="text" id="orderSearchInput" class="search-box-input" placeholder="Search by phone, UTR or Plan...">
            </div>
          </div>

          <% if (orders.length === 0) { %>
            <p style="color: var(--admin-muted);">No subscription orders placed yet.</p>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table" id="ordersTable">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Order ID</th>
                    <th>Driver Phone</th>
                    <th>Plan</th>
                    <th>Amount</th>
                    <th>UTR / Ref</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(ord => { %>
                  <tr class="order-row" data-search="<%= ord.phone + ' ' + (ord.utr || '') + ' ' + (ord.planName || '') + ' ' + ord.id %>">
                    <td><%= new Date(ord.createdAt).toLocaleString() %></td>
                    <td><code><%= ord.id %></code></td>
                    <td><strong><%= ord.phone %></strong></td>
                    <td><%= ord.planName %></td>
                    <td><span style="font-weight:750; color:var(--admin-primary);">₹<%= ord.amount || ord.price %></span></td>
                    <td><code><%= ord.utr || ord.upiRef || 'Waiting' %></code></td>
                    <td>
                      <span class="badge-tag <%= ord.status === 'Activated' ? 'badge-success' : 'badge-warning' %>">
                        <%= ord.status %>
                      </span>
                    </td>
                    <td>
                      <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                        <% if (ord.status !== 'Activated') { %>
                          <button class="btn-primary btn-sm" onclick="approveAndActivateOrder('<%= ord.id %>')">
                            ⚡ Approve &amp; Activate
                          </button>
                        <% } else { %>
                          <button class="btn-outline btn-sm" onclick="updateOrderStatus('<%= ord.id %>', 'Pending')">Revert</button>
                        <% } %>
                        <a href="https://wa.me/91<%= ord.phone %>?text=<%= encodeURIComponent('Namaste! Aapka RiderSaathi ' + ord.planName + ' plan verify aur activate ho gaya hai.') %>" target="_blank" class="btn-outline btn-sm" style="text-decoration:none;">
                          WhatsApp
                        </a>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ================= 9. TAB: CONTACT MESSAGES ================= -->
      <div class="tab-pane" id="tabInquiries">
        <div class="admin-card">
          <h2>Driver Contact Messages (<%= inquiries.length %>)</h2>
          <div class="admin-card-desc">Website ke Contact page se driver bhaiyon dwara bheje gaye messages:</div>

          <% if (inquiries.length === 0) { %>
            <p style="color: var(--admin-muted);">No messages received yet.</p>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
