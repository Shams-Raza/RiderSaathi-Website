            </div>

            <div class="form-actions">
              <button type="submit" class="btn-primary">🔒 Update Credentials</button>
            </div>
          </form>
        </div>

        <div class="admin-card">
          <h2>Complete System Data Backup</h2>
          <div class="admin-card-desc">
