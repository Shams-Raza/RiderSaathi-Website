<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard &amp; CMS — <%= settings.siteName %></title>
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin.js" defer></script>
</head>
<body class="admin-body">
  <!-- Mobile Header Bar -->
  <div class="mobile-admin-bar">
    <div style="display:flex; align-items:center; gap:8px;">
      <div class="brand-icon-wrap" style="width:28px; height:28px;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="#fff"><path d="M14 2 5 13h6l-1 9 9-11h-6z"/></svg>
      </div>
      <strong style="font-size:15px;"><%= settings.siteName %> Admin</strong>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
      <button class="mobile-menu-btn" id="mobileMenuToggle" aria-label="Toggle navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="admin-layout">
    <!-- Sidebar Navigation -->
    <aside class="admin-sidebar" id="adminSidebar">
      <a class="admin-brand" href="/admin">
        <div class="brand-icon-wrap">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="#fff"><path d="M14 2 5 13h6l-1 9 9-11h-6z"/></svg>
        </div>
        <span><%= settings.siteName %></span>
        <span class="badge">CMS</span>
      </a>

      <div class="admin-nav-section-title">Operations</div>
      <nav class="admin-nav">
        <button class="admin-nav-item active" data-tab="tabOverview">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Overview &amp; Stats
        </button>
        <button class="admin-nav-item" data-tab="tabDrivers">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          Drivers (<%= drivers.length %>)
          <span class="nav-counter"><%= drivers.length %></span>
        </button>
        <button class="admin-nav-item" data-tab="tabOrders">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          Orders (<%= orders.length %>)
          <span class="nav-counter"><%= orders.length %></span>
        </button>
      </nav>

      <div class="admin-nav-section-title">Website Content &amp; Numbers</div>
      <nav class="admin-nav">
        <button class="admin-nav-item" data-tab="tabNumbers">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line><line x1="10" y1="3" x2="8" y2="21"></line><line x1="16" y1="3" x2="14" y2="21"></line></svg>
          Website Numbers &amp; Config
        </button>
        <button class="admin-nav-item" data-tab="tabBilingual">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          Bilingual Content (HI / EN)
        </button>
        <button class="admin-nav-item" data-tab="tabPlans">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          Pricing Plans (<%= plans.length %>)
        </button>
        <button class="admin-nav-item" data-tab="tabHowItWorks">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          How It Works (Video CMS)
        </button>
        <button class="admin-nav-item" data-tab="tabApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
          APK &amp; Download Links
        </button>
        <button class="admin-nav-item" data-tab="tabGuides">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          Guides &amp; Tutorials (<%= guides.length %>)
        </button>
        <button class="admin-nav-item" data-tab="tabFaq">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          FAQs (<%= faqs.length %>)
        </button>
        <button class="admin-nav-item" data-tab="tabInquiries">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          Messages (<%= inquiries.length %>)
        </button>
      </nav>

      <div class="admin-nav-section-title">Business &amp; Social</div>
      <nav class="admin-nav">
        <button class="admin-nav-item" data-tab="tabSocial">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          Social Media &amp; Floating Dock
        </button>
        <button class="admin-nav-item" data-tab="tabCompany">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Office &amp; Google Maps
        </button>
        <button class="admin-nav-item" data-tab="tabContact">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          WhatsApp &amp; Helpline
        </button>
        <button class="admin-nav-item" data-tab="tabFooter">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Footer &amp; Legal CMS
        </button>
        <button class="admin-nav-item" data-tab="tabSeo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          SEO &amp; Meta Tags
        </button>
        <button class="admin-nav-item" data-tab="tabPayment">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          UPI &amp; Payments
        </button>
        <button class="admin-nav-item" data-tab="tabSecurity">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Security &amp; Backup
        </button>
      </nav>

      <div class="admin-sidebar-footer">
        <a href="/api/docs" target="_blank" class="btn-outline" style="text-decoration:none; font-size:12.5px;">
          ⚡ REST API Docs
        </a>
        <a href="/" target="_blank" class="btn-outline" style="text-decoration:none; font-size:12.5px;">
          🌐 View Live Site
        </a>
        <a href="/admin/logout" class="btn-outline" style="text-decoration:none; color:var(--admin-danger); font-size:12.5px;">
          🚪 Log Out
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="admin-main">
      <!-- Top Navbar Header -->
      <div class="admin-header">
        <div>
          <h1>Dashboard &amp; Content Management System</h1>
          <div style="font-size: 13.5px; color: var(--admin-muted); margin-top: 3px;">
            Full administrative control for <%= settings.siteName %> website, numbers, bilingual content &amp; driver APIs.
          </div>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
          <div class="admin-user-pill" title="Active Admin Session">
            <span class="status-dot"></span>
            <span><%= typeof adminEmail !== 'undefined' ? adminEmail : 'admin@ridersaathi.in' %></span>
          </div>
          <button id="themeToggleBtn" class="btn-outline" title="Toggle Light/Dark Theme">
            🌓 Theme
          </button>
          <a href="/api/admin/backup/export" class="btn-outline" style="text-decoration:none;">
            📥 Backup JSON
          </a>
        </div>
      </div>

      <!-- Toast Notification Message -->
      <div id="adminToast" class="toast-msg"></div>

      <!-- ================= 1. TAB: OVERVIEW ================= -->
      <div class="tab-pane active" id="tabOverview">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon-wrap" style="background:#eff6ff; color:#2563eb;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="stat-label">Active Drivers</div>
            <div class="stat-value"><%= drivers.length %></div>
            <div class="stat-desc">Registered Captains</div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrap" style="background:#f0fdf4; color:#16a34a;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
            </div>
            <div class="stat-label">Subscription Orders</div>
            <div class="stat-value"><%= orders.length %></div>
            <div class="stat-desc">Total UPI Leads</div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrap" style="background:#faf5ff; color:#9333ea;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </div>
            <div class="stat-label">APK Downloads</div>
            <div class="stat-value"><%= (stats && stats.downloads) || 0 %></div>
            <div class="stat-desc">Direct APK Clicks</div>
          </div>

          <div class="stat-card">
            <div class="stat-icon-wrap" style="background:#fffbeb; color:#d97706;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div class="stat-label">Page Views</div>
            <div class="stat-value"><%= (stats && stats.visitors) || 0 %></div>
            <div class="stat-desc">Website Visits</div>
          </div>
        </div>

        <div class="admin-card" style="margin-top: 24px;">
          <div class="admin-card-header">
            <h2>Recent Drivers (<%= drivers.slice(0, 5).length %> of <%= drivers.length %>)</h2>
            <button class="btn-outline btn-sm" onclick="switchTab('tabDrivers')">View All Drivers &rarr;</button>
          </div>
          <% if (drivers.length === 0) { %>
            <p style="color: var(--admin-muted);">No drivers registered yet.</p>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Driver</th>
                    <th>Phone</th>
                    <th>Version</th>
                    <th>Trial Left</th>
                    <th>Status</th>
                    <th>Quick Pass</th>
                  </tr>
                </thead>
                <tbody>
                  <% drivers.slice(0, 5).forEach(drv => { 
                    const trialLeft = Math.max(0, (drv.trialRidesTotal || 10) - (drv.trialRidesUsed || 0));
                  %>
                  <tr>
                    <td><strong><%= drv.name || 'Captain' %></strong></td>
                    <td><code><%= drv.phone %></code></td>
                    <td>v<%= drv.appVersion || '5.28.1' %></td>
                    <td><span style="font-weight:700; color:<%= trialLeft > 0 ? '#10b981' : '#ef4444' %>"><%= trialLeft %> rides</span></td>
                    <td>
                      <span class="badge-tag <%= drv.status === 'banned' ? 'badge-danger' : 'badge-success' %>">
                        <%= drv.status || 'active' %>
                      </span>
                    </td>
                    <td>
                      <button class="btn-primary btn-sm" onclick="grantSubscription('<%= drv.id %>', 7, '7 Days Pass')">+7 Days</button>
                      <button class="btn-outline btn-sm" onclick="grantTrialRides('<%= drv.id %>', 10)">+10 Free</button>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ================= 2. TAB: WEBSITE NUMBERS & CONFIGURATION (Requirement 3) ================= -->
      <div class="tab-pane" id="tabNumbers">
        <div class="admin-card">
          <h2>Website Numbers &amp; Business Configuration</h2>
          <div class="admin-card-desc">
            Website par dikhne wale saare numbers, counters, limits, stats aur pricing metrics ko yahan se edit karein.
            Yahan badlaav karte hi bina kisi redeployment ke website par turant live dikhega:
          </div>

          <% const nums = settings.numbers || {}; %>
          <form id="numbersSettingsForm">
            <div class="admin-table-wrap" style="margin-bottom: 24px;">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th style="width: 25%;">Field Name &amp; Key</th>
                    <th style="width: 20%;">Page / Section</th>
                    <th style="width: 35%;">Purpose / What it controls</th>
                    <th style="width: 20%;">Current Value (Editable)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Free Trial Rides</strong><br><code>numbers.freeTrialRides</code></td>
                    <td>Hero, Pricing, Badges, Sticky Bar</td>
                    <td>Har naye account ko milne wali free trial rides ki sankhya</td>
                    <td><input type="number" name="numbers[freeTrialRides]" value="<%= nums.freeTrialRides !== undefined ? nums.freeTrialRides : 10 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Starting Plan Price</strong><br><code>numbers.starterPrice</code></td>
                    <td>Hero CTA Button, Pricing Link</td>
                    <td>Hero button me "Plans (₹12 se shuru)" me dikhne wala minimum price</td>
                    <td><input type="number" name="numbers[starterPrice]" value="<%= nums.starterPrice !== undefined ? nums.starterPrice : 12 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Daily Savings Estimate</strong><br><code>numbers.dailySavingsEst</code></td>
                    <td>Testimonials &amp; Reviews</td>
                    <td>Driver review me bachat ka counter (e.g. 800+)</td>
                    <td><input type="text" name="numbers[dailySavingsEst]" value="<%= nums.dailySavingsEst || '800+' %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Active Captains Count</strong><br><code>numbers.activeCaptainsCount</code></td>
                    <td>Social Proof &amp; Stats</td>
                    <td>Website par active drivers ka display number (e.g. 10,000+)</td>
                    <td><input type="text" name="numbers[activeCaptainsCount]" value="<%= nums.activeCaptainsCount || '10,000+' %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Driver Rating</strong><br><code>numbers.satisfactionRating</code></td>
                    <td>Trust &amp; Review Cards</td>
                    <td>Captain satisfaction star rating (e.g. 4.9)</td>
                    <td><input type="text" name="numbers[satisfactionRating]" value="<%= nums.satisfactionRating || '4.9' %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Default Min Fare Rule</strong><br><code>numbers.minFareDefault</code></td>
                    <td>Rules Section &amp; Drivers App</td>
                    <td>Minimum kiraya rule card me default threshold (₹)</td>
                    <td><input type="number" name="numbers[minFareDefault]" value="<%= nums.minFareDefault !== undefined ? nums.minFareDefault : 50 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Min Fare Per KM</strong><br><code>numbers.minFarePerKm</code></td>
                    <td>Rules Section &amp; Simulator</td>
                    <td>Kam se kam per-km kiraya rule (₹/km)</td>
                    <td><input type="number" name="numbers[minFarePerKm]" value="<%= nums.minFarePerKm !== undefined ? nums.minFarePerKm : 12 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Max Pickup Distance (KM)</strong><br><code>numbers.maxPickupDistanceKm</code></td>
                    <td>Rules Section &amp; Simulator</td>
                    <td>Passenger pickup doori limit (KM)</td>
                    <td><input type="number" step="0.1" name="numbers[maxPickupDistanceKm]" value="<%= nums.maxPickupDistanceKm !== undefined ? nums.maxPickupDistanceKm : 2.5 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Short Ride Min Fare (₹)</strong><br><code>numbers.shortRideFareMin</code></td>
                    <td>Problem 2 Section</td>
                    <td>Chhoti ghaate wali rides ki minimum range (₹)</td>
                    <td><input type="number" name="numbers[shortRideFareMin]" value="<%= nums.shortRideFareMin !== undefined ? nums.shortRideFareMin : 20 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Short Ride Max Fare (₹)</strong><br><code>numbers.shortRideFareMax</code></td>
                    <td>Problem 2 Section</td>
                    <td>Chhoti ghaate wali rides ki maximum range (₹)</td>
                    <td><input type="number" name="numbers[shortRideFareMax]" value="<%= nums.shortRideFareMax !== undefined ? nums.shortRideFareMax : 30 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Long Ride Min KM</strong><br><code>numbers.longRideDistanceMin</code></td>
                    <td>Problem 2 Section</td>
                    <td>Lambi kamai wali ride ki minimum doori (KM)</td>
                    <td><input type="number" name="numbers[longRideDistanceMin]" value="<%= nums.longRideDistanceMin !== undefined ? nums.longRideDistanceMin : 15 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Long Ride Max KM</strong><br><code>numbers.longRideDistanceMax</code></td>
                    <td>Problem 2 Section</td>
                    <td>Lambi kamai wali ride ki maximum doori (KM)</td>
                    <td><input type="number" name="numbers[longRideDistanceMax]" value="<%= nums.longRideDistanceMax !== undefined ? nums.longRideDistanceMax : 20 %>" required></td>
                  </tr>
                  <tr>
                    <td><strong>Auto-Accept Speed (Sec)</strong><br><code>numbers.autoAcceptTimeSec</code></td>
                    <td>Problem 1 Section</td>
                    <td>App dwara ride grab karne ka timing (seconds)</td>
                    <td><input type="number" name="numbers[autoAcceptTimeSec]" value="<%= nums.autoAcceptTimeSec !== undefined ? nums.autoAcceptTimeSec : 1 %>" required></td>
                  </tr>
                  <!-- Simulator Mock Cards -->
                  <tr>
                    <td><strong>Simulator Card 1: Fare (₹)</strong><br><code>numbers.mock1Fare</code></td>
                    <td>Homepage Phone Simulator</td>
                    <td>Mock Rapido card kiraya (₹)</td>
                    <td><input type="number" name="numbers[mock1Fare]" value="<%= nums.mock1Fare || 128 %>"></td>
                  </tr>
                  <tr>
                    <td><strong>Simulator Card 1: Drop &amp; Pickup</strong><br><code>numbers.mock1DropKm / PickupKm</code></td>
                    <td>Homepage Phone Simulator</td>
                    <td>Card 1 drop KM / pickup KM</td>
                    <td>
                      <div style="display:flex; gap:6px;">
                        <input type="number" step="0.1" name="numbers[mock1DropKm]" value="<%= nums.mock1DropKm || 6.2 %>" placeholder="Drop KM">
                        <input type="number" step="0.1" name="numbers[mock1PickupKm]" value="<%= nums.mock1PickupKm || 0.8 %>" placeholder="Pickup KM">
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>Simulator Card 2: Fare &amp; Pickup</strong><br><code>numbers.mock2Fare / PickupKm</code></td>
                    <td>Homepage Phone Simulator</td>
                    <td>Mock Porter card kiraya (₹) aur pickup (KM)</td>
                    <td>
                      <div style="display:flex; gap:6px;">
                        <input type="number" name="numbers[mock2Fare]" value="<%= nums.mock2Fare || 24 %>" placeholder="Fare ₹">
