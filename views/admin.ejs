            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin-bottom: 24px;">
              <div class="toggle-switch-card">
                <div class="toggle-info">
                  <span class="toggle-title">Enable Floating Social Dock</span>
                  <span class="toggle-desc">Master switch to show/hide floating panel</span>
                </div>
                <label class="switch">
                  <input type="checkbox" name="floatingSocial[enabled]" <%= float.enabled !== false ? 'checked' : '' %>>
                  <span class="slider"></span>
                </label>
              </div>

              <div class="toggle-switch-card">
                <div class="toggle-info">
                  <span class="toggle-title">Visible by Default on First Visit</span>
                  <span class="toggle-desc">Show open icons for first time visitors</span>
                </div>
                <label class="switch">
                  <input type="checkbox" name="floatingSocial[showByDefault]" <%= float.showByDefault !== false ? 'checked' : '' %>>
                  <span class="slider"></span>
                </label>
