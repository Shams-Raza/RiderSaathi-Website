<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : settings.siteName + ' — ride filter app for Rapido, Uber and Porter drivers' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Independent ride-filtering app for Rapido, Uber and Porter drivers. Apni pasand ki rides chuno — trip distance, pickup limit, booking type, kamai aur ghar ka route. Pehli 10 rides free.' %>">
  <meta name="keywords" content="ride filter app for drivers, rapido ride filter app, uber driver ride filter, porter delivery filter, rider saathi, driver ride assistant, ride filter karne wala app, driver productivity app">
  <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#1E3A9E">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/main.js" defer></script>
</head>
<body>
<% if (settings.showBanner && settings.bannerAlert) { %>
<div class="top-bar">
  <span>⚡ <%= settings.bannerAlert %></span>
  <a href="/install">Try Free →</a>
</div>
<% } %>

<header>
  <div class="wrap">
    <a class="brand" href="/">
      <span class="glyph">
        <svg viewBox="0 0 24 24"><path d="M14 2 5 13h6l-1 9 9-11h-6z"/></svg>
      </span>
      <%= settings.siteName %>
    </a>
    <nav id="mainNav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/guides" class="<%= currentPath === '/guides' ? 'active' : '' %>">Guides</a>
      <a href="/faq" class="<%= currentPath === '/faq' ? 'active' : '' %>">FAQ</a>
      <a href="/install" class="<%= currentPath === '/install' ? 'active' : '' %>">Install</a>
      <a href="/pricing" class="<%= currentPath === '/pricing' ? 'active' : '' %>">Pricing</a>
      <a href="/updates" class="<%= currentPath === '/updates' ? 'active' : '' %>">Updates</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>
    <div class="header-right">
      <button class="theme-toggle" id="themeToggle" title="Toggle Light/Dark Theme" aria-label="Toggle theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="mobile-nav-toggle" id="navToggle" aria-label="Toggle navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>
